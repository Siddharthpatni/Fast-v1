# FastMile Environment Configuration
# Copy this to .env and fill in your values

# ── Database ──
POSTGRES_USER=fastmile
POSTGRES_PASSWORD=fastmile_dev
POSTGRES_DB=fastmile
DATABASE_URL=postgresql+asyncpg://fastmile:fastmile_dev@db:5432/fastmile

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── LLM (disruption report extraction) ──
# "ollama" (local), "openai", "openrouter" (free models), "none" (rules only),
# or a fallback chain: "openrouter,ollama" tries OpenRouter first, then the local model
LLM_PROVIDER=ollama
# Empty = provider default (ollama: qwen2.5:7b-instruct, openrouter: the free models in
# backend/app/services/llm/client.py DEFAULT_MODELS; missing ones are skipped at startup).
# For OpenRouter, a comma-separated list is tried in order.
LLM_MODEL=
OPENAI_API_KEY=sk-your-key-here
# https://openrouter.ai/keys — free models need no credit
OPENROUTER_API_KEY=
# Paid model tried after the free ones fail (free models: 50 requests/day while under $10
# of credit is bought). Chosen by benchmark: 77% fully correct on the 30 dev reports, about
# $0.0002 per report. Capped per UTC day so it can't drain the credit. Empty = free only.
LLM_PAID_MODEL=deepseek/deepseek-v4-flash
LLM_PAID_DAILY_LIMIT=200
# From inside Docker, the host's Ollama is host.docker.internal (localhost would be the container)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Provider data ──
# Paths inside the backend container (./data is mounted at /data).
# Real data: run `make real-data`, then use these. Dev fixtures: /data/gtfs_dev, /data/gbfs_dev.
GTFS_PATH=/data/gtfs_region
# GTFS-Realtime: delays, cancellations and service alerts (free nationwide feed, ~50 MB)
GTFS_RT_URL=https://realtime.gtfs.de/realtime-free.pb
GTFS_RT_REFRESH_SECONDS=300
# Comma-separated gbfs.json URLs and/or local GBFS directories
GBFS_FEEDS=https://gbfs.nextbike.net/maps/gbfs/v2/nextbike_dn/gbfs.json
# "none" disables on-demand; /data/on_demand_zones.json holds invented dev zones
ON_DEMAND_ZONES_PATH=none

# ── Street routing (walk / bike / car legs) ──
# "osrm" = real street times and map lines; "none" = straight-line estimates.
# Default server: FOSSGIS public OSRM (free, no key, fair use). Self-host for heavy use.
STREET_ROUTING=osrm
STREET_ROUTING_URL=https://routing.openstreetmap.de/routed-{profile}

# ── Germany-wide trips and place search ──
# Trips with both ends inside GTFS_PATH's region use FastMile's own router. Any other trip
# in Germany, and place search, go to Transitous (free community MOTIS server, fair use).
# Empty = region only.
TRANSITOUS_URL=https://api.transitous.org

# ── Address search fallback ── Photon (free OSM geocoder), used when Transitous fails
GEOCODER_URL=https://photon.komoot.io/api/

# ── Rate limits (requests per minute per client IP; counted in Redis) ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REPORTS_PER_MIN=10
RATE_LIMIT_PLANS_PER_MIN=60
RATE_LIMIT_GEOCODE_PER_MIN=60

# ── Jev / TypeSafe AI (fast decisions) ──
# Get your key at https://typesafe.ai
JEV_API_KEY=your-jev-api-key-here
JEV_MODEL=jev-latest

# ── Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
LOG_LEVEL=info

# ── Frontend ──
# Leave empty: the app calls /api on its own origin and Vite forwards it to the backend
VITE_API_URL=

# ── Site operator: shown in the Impressum (§ 5 DDG) and privacy notice ──
# Required before the site is public in Germany. Use \n between address lines.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
